        top_genes = "reports/datasets/{dataset_id}/top_loading_genes.tsv",
        correlations = "reports/datasets/{dataset_id}/pc_technical_correlations.tsv",
        var_explained = "reports/datasets/{dataset_id}/pca_variance_explained.tsv",
        fig_index = "reports/datasets/{dataset_id}/figure_index_m5.tsv",
        elbow_pdf = "reports/datasets/{dataset_id}/pca_elbow.pdf",
        elbow_png = "reports/datasets/{dataset_id}/pca_elbow.png",
        cum_pdf = "reports/datasets/{dataset_id}/pca_cumulative_variance.pdf",
        cum_png = "reports/datasets/{dataset_id}/pca_cumulative_variance.png",
        loadings_pdf = "reports/datasets/{dataset_id}/pca_loadings.pdf",
        loadings_png = "reports/datasets/{dataset_id}/pca_loadings.png",
