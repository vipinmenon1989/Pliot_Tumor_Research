        doublet_json = "reports/datasets/{dataset_id}/doublet_report.json",
        manifest = "reports/datasets/{dataset_id}/manifest_filtered.json",
        prov = "reports/datasets/{dataset_id}/filtering_provenance.json",
        violins_pdf = "reports/datasets/{dataset_id}/filtered_qc_violins.pdf",
        violins_png = "reports/datasets/{dataset_id}/filtered_qc_violins.png",
        density_pdf = "reports/datasets/{dataset_id}/filtered_qc_density.pdf",
        density_png = "reports/datasets/{dataset_id}/filtered_qc_density.png",
        histograms_pdf = "reports/datasets/{dataset_id}/filtered_qc_histograms.pdf",
        histograms_png = "reports/datasets/{dataset_id}/filtered_qc_histograms.png",
        scatter_pdf = "reports/datasets/{dataset_id}/filtered_qc_scatter.pdf",
        scatter_png = "reports/datasets/{dataset_id}/filtered_qc_scatter.png",
        summary_pdf = "reports/datasets/{dataset_id}/filtering_summary.pdf",
        summary_png = "reports/datasets/{dataset_id}/filtering_summary.png",
        doublet_pdf = "reports/datasets/{dataset_id}/doublet_summary.pdf",
        doublet_png = "reports/datasets/{dataset_id}/doublet_summary.png",
        fig_index_m3 = "reports/datasets/{dataset_id}/figure_index_m3.tsv",
        stats_tsv = "reports/datasets/{dataset_id}/filtering_statistics.tsv",
        summary_tsv = "reports/datasets/{dataset_id}/filtered_qc_metrics_summary.tsv"
    log:
        log = "logs/workflow/filter_doublets_{dataset_id}.log"
    benchmark:
        "benchmarks/filter_doublets_{dataset_id}.tsv"
    resources:
        cpus = 1,
        mem_mb = 24000,
        runtime = 45
    shell:
        """
        Rscript {input.script} \
          --input {input.rds} \
          --dataset-id {wildcards.dataset_id} \
          --out-rds {output.rds} \
          --out-report {output.report} \
          --out-doublet-json {output.doublet_json} \
          --out-prov {output.prov} \
          --out-manifest {output.manifest} \
          --out-plot-dir reports/datasets/{wildcards.dataset_id} \
