# Rule to perform QC filtering using dataset-specific thresholds (Strategy B - Specific QC)
rule filter_and_detect_doublets_specific:
    input:
        rds = "results/datasets/{dataset_id}/{dataset_id}_raw.rds",
        script = "scripts/R/filter_and_detect_doublets.R",
        logging = "scripts/R/logging_utils.R",
        prov = "scripts/R/provenance_utils.R"
    params:
        min_features = lambda wildcards: config['dataset_specific_qc'][wildcards.dataset_id]['min_features'],
        max_features = lambda wildcards: config['dataset_specific_qc'][wildcards.dataset_id]['max_features'],
        min_counts = lambda wildcards: config['dataset_specific_qc'][wildcards.dataset_id]['min_counts'],
        max_counts = lambda wildcards: config['dataset_specific_qc'][wildcards.dataset_id]['max_counts'],
        max_percent_mt = lambda wildcards: config['dataset_specific_qc'][wildcards.dataset_id]['max_percent_mt'],
        max_percent_ribo = lambda wildcards: config['dataset_specific_qc'][wildcards.dataset_id]['max_percent_ribo']
    output:
        rds = "results/datasets/{dataset_id}/{dataset_id}_filtered_specific.rds",
        report = "reports/datasets/{dataset_id}/FILTER_REPORT_SPECIFIC.md",
        doublet_json = "reports/datasets/{dataset_id}/doublet_report_specific.json",
        manifest = "reports/datasets/{dataset_id}/manifest_filtered_specific.json",
        prov = "reports/datasets/{dataset_id}/filtering_provenance_specific.json",
        violins_pdf = "reports/datasets/{dataset_id}/filtered_qc_violins_specific.pdf",
        violins_png = "reports/datasets/{dataset_id}/filtered_qc_violins_specific.png",
        density_pdf = "reports/datasets/{dataset_id}/filtered_qc_density_specific.pdf",
        density_png = "reports/datasets/{dataset_id}/filtered_qc_density_specific.png",
        histograms_pdf = "reports/datasets/{dataset_id}/filtered_qc_histograms_specific.pdf",
        histograms_png = "reports/datasets/{dataset_id}/filtered_qc_histograms_specific.png",
        scatter_pdf = "reports/datasets/{dataset_id}/filtered_qc_scatter_specific.pdf",
        scatter_png = "reports/datasets/{dataset_id}/filtered_qc_scatter_specific.png",
        summary_pdf = "reports/datasets/{dataset_id}/filtering_summary_specific.pdf",
        summary_png = "reports/datasets/{dataset_id}/filtering_summary_specific.png",
        doublet_pdf = "reports/datasets/{dataset_id}/doublet_summary_specific.pdf",
        doublet_png = "reports/datasets/{dataset_id}/doublet_summary_specific.png",
        fig_index_m3 = "reports/datasets/{dataset_id}/figure_index_m3_specific.tsv",
        stats_tsv = "reports/datasets/{dataset_id}/filtering_statistics_specific.tsv",
        summary_tsv = "reports/datasets/{dataset_id}/filtered_qc_metrics_summary_specific.tsv"
    log:
        log = "logs/workflow/filter_doublets_{dataset_id}_specific.log"
    benchmark:
        "benchmarks/filter_doublets_{dataset_id}_specific.tsv"
    resources:
        cpus = 1,
        mem_mb = 24000,
        runtime = 45
    shell:
        """
        Rscript {input.script} \
          --input {input.rds} \
          --dataset-id {wildcards.dataset_id} \
          --out-rds {output.rds} \
          --out-report {output.report} \
          --out-doublet-json {output.doublet_json} \
          --out-prov {output.prov} \
          --out-manifest {output.manifest} \
          --out-plot-dir reports/datasets/{wildcards.dataset_id} \
          --rule filter_and_detect_doublets_specific \
          --out-suffix _specific \
          --min-features {params.min_features} \
          --max-features {params.max_features} \
          --min-counts {params.min_counts} \
          --max-counts {params.max_counts} \
          --max-percent-mt {params.max_percent_mt} \
          --max-percent-ribo {params.max_percent_ribo} \
          --expected-doublet-rate {config[doublet_detection][expected_doublet_rate]} \
          --doublet-method {config[doublet_detection][method]} > {log.log} 2>&1
        """

