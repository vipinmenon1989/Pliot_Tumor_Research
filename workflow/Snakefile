# Rule to extract dataset-specific objects
rule extract_dataset:
    input:
        rds = config["input_rds"],
        script = "scripts/R/extract_dataset.R",
        logging = "scripts/R/logging_utils.R",
        prov = "scripts/R/provenance_utils.R"
    output:
        rds = "results/datasets/{dataset_id}/{dataset_id}_raw.rds",
        val_md = "reports/datasets/{dataset_id}/DATASET_VALIDATION.md",
        manifest = "reports/datasets/{dataset_id}/manifest.json",
        prov = "results/datasets/{dataset_id}/extraction_provenance.json"
    log:
        log = "logs/workflow/extract_{dataset_id}.log"
    benchmark:
        "benchmarks/extract_{dataset_id}.tsv"
    resources:
        cpus = 1,
        mem_mb = 24000,
        runtime = 30
    shell:
        """
        Rscript {input.script} \
          --input {input.rds} \
          --dataset-id {wildcards.dataset_id} \
          --id-column {config[dataset_id_column]} \
          --out-rds {output.rds} \
          --out-val-md {output.val_md} \
          --out-manifest {output.manifest} \
          --out-prov {output.prov} > {log.log} 2>&1
        """

# Rule to generate pre-filter QC plots and stats tables
rule generate_qc_plots:
    input:
        rds = "results/datasets/{dataset_id}/{dataset_id}_raw.rds",
        script = "scripts/R/generate_qc_plots.R",
        logging = "scripts/R/logging_utils.R",
        prov = "scripts/R/provenance_utils.R"
    output:
        violins_pdf = "reports/datasets/{dataset_id}/qc_violins.pdf",
        violins_png = "reports/datasets/{dataset_id}/qc_violins.png",
        scatter_pdf = "reports/datasets/{dataset_id}/qc_scatter.pdf",
        scatter_png = "reports/datasets/{dataset_id}/qc_scatter.png",
        histograms_pdf = "reports/datasets/{dataset_id}/qc_histograms.pdf",
        histograms_png = "reports/datasets/{dataset_id}/qc_histograms.png",
        metrics_pdf = "reports/datasets/{dataset_id}/qc_metrics.pdf",
        metrics_png = "reports/datasets/{dataset_id}/qc_metrics.png",
        qc_table = "reports/datasets/{dataset_id}/qc_metrics_summary.tsv",
        fig_index = "reports/datasets/{dataset_id}/figure_index.tsv",
        prov = "reports/datasets/{dataset_id}/qc_plots_provenance.json"
    log:
        log = "logs/workflow/qc_plots_{dataset_id}.log"
    benchmark:
        "benchmarks/qc_plots_{dataset_id}.tsv"
    resources:
        cpus = 1,
        mem_mb = 8000,
        runtime = 15
    shell:
        """
        Rscript {input.script} \
          --input {input.rds} \
          --dataset-id {wildcards.dataset_id} \
          --out-dir reports/datasets/{wildcards.dataset_id} \
          --out-prov {output.prov} \
          --rule generate_qc_plots > {log.log} 2>&1
        """

