# Rule to perform comparison between Global and Dataset-Specific QC strategies
rule compare_qc_strategies:
    input:
        rds_global = expand("results/datasets/{dataset_id}/{dataset_id}_filtered.rds", dataset_id=config["datasets"]),
        rds_specific = expand("results/datasets/{dataset_id}/{dataset_id}_filtered_specific.rds", dataset_id=config["datasets"]),
