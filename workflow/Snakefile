# Snakemake workflow for MPNST Phase 1 Analysis
# Developed incrementally, starting with synthetic validation rules.

import os
import yaml
import jsonschema

# Load Configuration
configfile: "config/config.yaml"

# Default rule target
# Default rule target
rule all:
    input:
        "logs/workflow/validate_config.done",
        "logs/workflow/smoke_test.done",
        "reports/DATA_AUDIT.md",
        "reports/DATASET_STRUCTURE.tsv",
        "reports/object_inventory.json",
        "reports/object_inventory.tsv",
        "reports/milestones/M1_REPORT.md",
        "reports/audits/m1_audit_provenance.json",
        "logs/workflow/test_audit.done"

# Rule to validate configuration format and parameters against schema
rule validate_config:
    input:
        config = workflow.overwrite_configfiles[0] if workflow.overwrite_configfiles else "config/config.yaml",
        schema = "config/schemas/config.schema.yaml"
    output:
        done = "logs/workflow/validate_config.done"
    log:
        log = "logs/workflow/validate_config.log"
    run:
        with open(input.config, 'r') as f:
            cfg = yaml.safe_load(f)
        with open(input.schema, 'r') as f:
            sch = yaml.safe_load(f)

        with open(str(log.log), 'w') as log_f:
            try:
                jsonschema.validate(instance=cfg, schema=sch)
                log_f.write("Configuration is valid according to schema.\n")
                print("Configuration is valid.")
            except jsonschema.exceptions.ValidationError as err:
                log_f.write(f"Validation Error: {err.message}\n")
                raise err

        # Create output marker file
        with open(str(output.done), 'w') as out_f:
            out_f.write("VALIDATED")

# Rule to generate synthetic data (M0 Smoke Fixture)
rule generate_synthetic:
    input:
        script = "scripts/R/generate_synthetic_data.R",
        logging = "scripts/R/logging_utils.R",
        prov = "scripts/R/provenance_utils.R"
    output:
        rds = "data/synthetic/synthetic_mpnst.rds"
    log:
        log = "logs/workflow/generate_synthetic.log"
    benchmark:
        "benchmarks/generate_synthetic.tsv"
    resources:
        cpus = 1,
        mem_mb = 4000,
        runtime = 10 # minutes
    shell:
        """
        Rscript {input.script} > {log.log} 2>&1
        """

# Rule to run project smoke tests
rule smoke_test:
    input:
        script = "tests/unit/test_smoke.R",
        rds = "data/synthetic/synthetic_mpnst.rds"
    output:
        done = "logs/workflow/smoke_test.done"
    log:
        log = "logs/workflow/smoke_test.log"
    resources:
        cpus = 1,
        mem_mb = 4000,
        runtime = 10
    shell:
        """
        Rscript {input.script} > {log.log} 2>&1 && touch {output.done}
        """

# Rule to perform Seurat object audit
rule audit:
    input:
        rds = config["input_rds"],
        script = "scripts/R/audit_object.R",
        logging = "scripts/R/logging_utils.R",
        prov = "scripts/R/provenance_utils.R"
    output:
        audit_md = "reports/DATA_AUDIT.md",
        structure_tsv = "reports/DATASET_STRUCTURE.tsv",
        inventory_json = "reports/object_inventory.json",
        inventory_tsv = "reports/object_inventory.tsv",
        m1_report = "reports/milestones/M1_REPORT.md",
        provenance = "reports/audits/m1_audit_provenance.json"
    log:
        log = "logs/workflow/audit.log"
    benchmark:
        "benchmarks/audit.tsv"
    resources:
        cpus = 8,
        mem_mb = 128000,
        runtime = 720
    shell:
        """
        Rscript {input.script} \
          --input {input.rds} \
          --out-md {output.audit_md} \
          --out-struct {output.structure_tsv} \
          --out-json {output.inventory_json} \
          --out-tsv {output.inventory_tsv} \
          --out-report {output.m1_report} \
          --out-prov {output.provenance} > {log.log} 2>&1
        """

