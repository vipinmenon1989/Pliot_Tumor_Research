        heatmaps_png = "reports/datasets/{dataset_id}/pca_heatmaps.png",
        correlations_pdf = "reports/datasets/{dataset_id}/pca_correlations.pdf",
        correlations_png = "reports/datasets/{dataset_id}/pca_correlations.png"
    log:
