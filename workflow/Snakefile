# Rule to merge local figure indices into a single reports/FIGURE_INDEX.tsv
rule merge_figure_index:
    input:
        indices_m2 = expand("reports/datasets/{dataset_id}/figure_index.tsv", dataset_id=config["datasets"]),
        indices_m3 = expand("reports/datasets/{dataset_id}/figure_index_m3.tsv", dataset_id=config["datasets"]),
        indices_m3_spec = expand("reports/datasets/{dataset_id}/figure_index_m3_specific.tsv", dataset_id=config["datasets"]),
        indices_m4 = expand("reports/datasets/{dataset_id}/figure_index_m4.tsv", dataset_id=config["datasets"]),
        indices_m5 = expand("reports/datasets/{dataset_id}/figure_index_m5.tsv", dataset_id=config["datasets"]),
        indices_opt = "reports/qc_optimization/figure_index_optimization.tsv",
        indices_comp = "reports/qc_comparison/figure_index_comparison.tsv"
    output:
        merged = "reports/FIGURE_INDEX.tsv"
    log:
        log = "logs/workflow/merge_figure_index.log"
    run:
        all_paths = list(input.indices_m2) + list(input.indices_m3) + list(input.indices_m3_spec) + list(input.indices_m4) + list(input.indices_m5) + [input.indices_opt, input.indices_comp]
        with open(output.merged, 'w') as out_f:
            header_written = False
            for path in all_paths:
                if not os.path.exists(path):
                    continue
                with open(path, 'r') as in_f:
                    lines = in_f.readlines()
                    if not lines:
                        continue
                    if not header_written:
                        out_f.write(lines[0])
                        header_written = True
                    for line in lines[1:]:
                        out_f.write(line)

