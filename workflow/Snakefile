# Rule to perform QC filtering and doublet detection (Strategy A - Global QC)
rule filter_and_detect_doublets:
    input:
        rds = "results/datasets/{dataset_id}/{dataset_id}_raw.rds",
        script = "scripts/R/filter_and_detect_doublets.R",
        logging = "scripts/R/logging_utils.R",
        prov = "scripts/R/provenance_utils.R"
    output:
        rds = "results/datasets/{dataset_id}/{dataset_id}_filtered.rds",
